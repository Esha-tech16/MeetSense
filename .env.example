# Copy this file to .env and enter your real PostgreSQL password and Groq API key.
# Keep .env private; never commit it or share its contents.
SECRET_KEY=ABC
DB_PASSWORD=esha06
DB_USER=postgres
DB_HOST=localhost
# auto checks ports 5433 and 5432 and prefers the instance with your existing project tables.
DB_PORT=auto
DB_NAME=meetsense_db

PORT=5000
OPEN_BROWSER=true
MAX_UPLOAD_MB=200

# Audio transcription runs locally using Whisper; the first run downloads the Whisper model.
WHISPER_MODEL=base

# Meeting summaries, decisions, and action items use Groq's hosted API (no local LLM download).
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-20b
